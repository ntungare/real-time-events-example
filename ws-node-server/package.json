{
    "name": "ws-node-server",
    "version": "1.0.0",
    "description": "auth for the app",
    "main": "./dist/index.js",
    "keywords": [
        "express",
        "jwt"
    ],
    "scripts": {
        "check": "tsc --noEmit",
        "prebuild": "pnpm run clean",
        "clean": "rm -rf dist",
        "build": "pnpm run build:node",
        "build:node": "NODE_ENV=production tsc",
        "start": "node ./dist/index.js",
        "start:dev": "NODE_ENV=development ts-node-dev --inspect=9221 -- ./src/index.ts",
        "lint": "eslint .",
        "lint:fix": "pnpm run lint -- --fix"
    },
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.12.3",
    "dependencies": {
        "body-parser": "^2.2.0",
        "compression": "^1.8.1",
        "express": "^5.1.0",
        "uuid": "^13.0.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/body-parser": "^1.19.6",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.5",
        "@types/node": "^24.10.1",
        "@types/ws": "^8.18.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.5.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.4"
    }
}
