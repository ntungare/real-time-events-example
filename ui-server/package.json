{
    "name": "ui-server",
    "version": "1.0.0",
    "description": "ui-server for the app",
    "main": "./dist/server/index.js",
    "keywords": [
        "express",
        "jwt",
        "react",
        "ssr"
    ],
    "scripts": {
        "check": "tsc --noEmit --extendedDiagnostics",
        "clean": "rm -rf dist",
        "build": "pnpm run build:node && pnpm run build:bundles",
        "build:node": "NODE_ENV=production tsc",
        "build:bundles": "pnpm run build:bundle:client --mode=production && pnpm run build:bundle:server --mode=production",
        "build:bundle:client": "vite build --config ./vite.client.config.ts",
        "build:bundle:server": "vite build --config ./vite.server.config.ts",
        "start": "node ./dist/server/index.js",
        "start:dev": "concurrently --prefixColors auto pnpm:start:dev:node pnpm:start:dev:bundle:client pnpm:start:dev:bundle:server",
        "start:dev:node": "pnpm run wait-on && NODE_ENV=development ts-node-dev --inspect=9220 -- ./src/server/index.ts",
        "start:dev:bundles": "concurrently --prefixColors auto pnpm:start:dev:bundle:client pnpm:start:dev:bundle:server",
        "start:dev:bundle:client": "pnpm run build:bundle:client --minify=false --watch --mode=development",
        "start:dev:bundle:server": "pnpm run build:bundle:server --minify=false --watch --mode=development",
        "wait-on": "node ./wait-on.mjs",
        "lint": "eslint .",
        "lint:fix": "pnpm run lint -- --fix"
    },
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.12.3",
    "dependencies": {
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/server": "^11.11.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.5",
        "@stomp/stompjs": "^7.2.1",
        "@tanstack/react-query": "^5.90.10",
        "@tanstack/react-query-devtools": "^5.90.2",
        "axios": "^1.13.2",
        "body-parser": "^2.2.0",
        "bufferutil": "^4.0.9",
        "compression": "^1.8.1",
        "express": "^5.1.0",
        "htmlescape": "^1.1.1",
        "jsonwebtoken": "^9.0.2",
        "lodash-es": "^4.17.21",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-stomp-hooks": "^3.0.1",
        "react-use-websocket": "^4.13.0",
        "utf-8-validate": "^6.0.5",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@tanstack/eslint-plugin-query": "^5.91.2",
        "@types/body-parser": "^1.19.6",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.5",
        "@types/htmlescape": "^1.1.3",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.5.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.2",
        "wait-on": "^9.0.3"
    }
}
